# Copy this file to .env and fill in real values.

# Clerk auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mapbox (https://account.mapbox.com/access-tokens)
# Same token can be used for both - MAPBOX_ACCESS_TOKEN is read server-side
# (search/autofill API routes), NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN is exposed to
# the browser (map rendering, client-side address lookups).
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Database (Prisma, mysql)
DATABASE_URL=
# Only needed when running `prisma migrate dev`
SHADOW_DATABASE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
